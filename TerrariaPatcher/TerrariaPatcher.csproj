<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net481</TargetFramework>
		<PlatformTarget>x86</PlatformTarget>
		<Prefer32Bit>false</Prefer32Bit>
		<UseWindowsForms>true</UseWindowsForms>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<ApplicationIcon>Terraria.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Configurations>Debug;Release;Release (Public)</Configurations>
		<Platforms>x86</Platforms>
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<OutputPath>bin\Debug\</OutputPath>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<OutputPath>bin\Release\</OutputPath>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Release (Public)' ">
		<OutputPath>bin\Release (Public)\</OutputPath>
		<DefineConstants>$(DefineConstants);PUBLIC</DefineConstants>
		<Optimize>true</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<Compile Update="CopyPlugins.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="CopyPlugins.Designer.cs">
			<DependentUpon>CopyPlugins.cs</DependentUpon>
		</Compile>
		<Compile Update="Main.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="Main.Designer.cs">
			<DependentUpon>Main.cs</DependentUpon>
		</Compile>
		<Compile Update="Properties\Resources.Designer.cs">
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
			<DesignTime>True</DesignTime>
		</Compile>
		<Compile Update="Properties\Settings.Designer.cs">
			<AutoGen>True</AutoGen>
			<DependentUpon>Settings.settings</DependentUpon>
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="CopyPlugins.resx">
			<DependentUpon>CopyPlugins.cs</DependentUpon>
		</EmbeddedResource>
		<EmbeddedResource Update="Main.resx">
			<DependentUpon>Main.cs</DependentUpon>
		</EmbeddedResource>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
			<SubType>Designer</SubType>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Include="App.config" />
		<None Include="app.manifest" />
		<None Include="Properties\Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
		<Content Include="Terraria.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Mono.Cecil" Version="0.11.6" />
		<PackageReference Include="System.Resources.Extensions" Version="9.0.0" />
		<Reference Include="System.IO.Compression" />
		<Reference Include="System.IO.Compression.FileSystem" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PluginLoader.XNA\PluginLoader.XNA.csproj">
			<Aliases>PluginLoaderXNA</Aliases>
		</ProjectReference>
	</ItemGroup>

	<Target Name="CopyPluginsToOutput" AfterTargets="Build" Condition=" '$(Configuration)' == 'Debug' ">
		<ItemGroup>
			<PluginSource Include="..\TranscendPlugins\*.cs" />
			<SharedPluginSource Include="..\TranscendPlugins\Shared\**\*.cs" />
		</ItemGroup>

		<RemoveDir Directories="$(OutputPath)Plugins" />

		<Copy SourceFiles="@(PluginSource)" DestinationFolder="$(OutputPath)Plugins" />
		<Copy SourceFiles="@(SharedPluginSource)" DestinationFolder="$(OutputPath)Plugins\Shared\%(RecursiveDir)" />
	</Target>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
	  <Exec Command="IF &quot;$(Configuration)&quot; == &quot;Debug&quot; EXIT&#xD;&#xA;IF &quot;$(Configuration)&quot; == &quot;Release&quot; SET zip=$(ProjectDir)..\TerrariaPatcher.zip&#xD;&#xA;IF &quot;$(Configuration)&quot; == &quot;Release (Public)&quot; SET zip=$(ProjectDir)..\TerrariaPatcher.public.zip&#xD;&#xA;IF EXIST &quot;%25zip%25&quot; DEL &quot;%25zip%25&quot;&#xD;&#xA;&quot;C:\Program Files\WinRAR\WINRAR.exe&quot; a -ep1 &quot;%25zip%25&quot; &quot;$(TargetDir)TerrariaPatcher.exe&quot; &quot;$(TargetDir)PluginLoader.XNA.dll&quot; &quot;$(TargetDir)Mono.Cecil.dll&quot; &quot;$(TargetDir)Mono.Cecil.Rocks.dll&quot; &quot;$(TargetDir)TerrariaPatcher.exe.config&quot; &quot;$(ProjectDir)changelog.txt&quot;&#xD;&#xA;&quot;C:\Program Files\WinRAR\WINRAR.exe&quot; a -ep1 -apPlugins &quot;%25zip%25&quot; &quot;$(ProjectDir)\..\TranscendPlugins\*.cs&quot;&#xD;&#xA;&quot;C:\Program Files\WinRAR\WINRAR.exe&quot; a -ep1 -r -apPlugins\Shared &quot;%25zip%25&quot; &quot;$(ProjectDir)\..\TranscendPlugins\Shared\*.cs&quot;" />
	</Target>

</Project>